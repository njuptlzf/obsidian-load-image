{
  "name": "@njuptlzf/obsidian-load-image",
  "version": "1.1.1",
  "description": "Obsidian plugin: paste images into a configurable folder (note-relative, relative path, or vault-absolute) with automatic folder creation.",
  "main": "main.js",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "image",
    "paste",
    "attachment",
    "clipboard"
  ],
  "author": "njuptlzf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njuptlzf/obsidian-load-image.git"
  },
  "bugs": {
    "url": "https://github.com/njuptlzf/obsidian-load-image/issues"
  },
  "homepage": "https://github.com/njuptlzf/obsidian-load-image#readme",
  "files": [
    "main.js",
    "manifest.json",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "esbuild": "^0.20.2",
    "obsidian": "^1.5.7",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}